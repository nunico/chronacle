{
	"$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
	"productName": "Chronacle",
	"version": "0.3.0",
	"identifier": "dev.tea-driven.chronacle.desktop",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://127.0.0.1:1420",
		"beforeDevCommand": "pnpm dev",
		"beforeBuildCommand": "pnpm build"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Chronacle",
				"width": 1200,
				"height": 800,
				"resizable": true,
				"fullscreen": false,
				"devtools": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": [
			"resources/pdfium/**/*",
			"resources/onnxruntime/**/*"
		]
	}
}
